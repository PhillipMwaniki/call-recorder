{
    "save-folder": {
        "type": "filechooser",
        "select-dir": true,
        "default": "~/Recordings/Calls",
        "description": "Save recordings in"
    },
    "format": {
        "type": "combobox",
        "default": "ogg",
        "description": "Recording format",
        "options": {
            "Opus (.ogg): smaller files, best for voice": "ogg",
            "MP3 (.mp3): plays on any device": "mp3"
        },
        "tooltip": "Opus uses about 30 MB per hour; MP3 (96 kbps) about 45 MB per hour."
    },
    "show-timer": {
        "type": "switch",
        "default": true,
        "description": "Show elapsed time in the panel while recording"
    },
    "auto-transcribe": {
        "type": "switch",
        "default": true,
        "description": "Transcribe calls automatically after recording",
        "tooltip": "Runs whisper.cpp on this computer; nothing is uploaded. The transcript is saved next to the recording as a .txt file."
    },
    "transcript-language": {
        "type": "combobox",
        "default": "auto",
        "description": "Spoken language",
        "options": {
            "Detect automatically": "auto",
            "English": "en",
            "Swahili": "sw"
        },
        "dependency": "auto-transcribe"
    },
    "transcript-model": {
        "type": "combobox",
        "default": "small",
        "description": "Transcription model",
        "options": {
            "Base: fastest, less accurate (60 MB)": "base",
            "Small: balanced (190 MB)": "small",
            "Medium: most accurate, slow (540 MB)": "medium"
        },
        "tooltip": "Choosing a model you haven't downloaded yet shows \"Set up transcription\u2026\" in the menu."
    }
}
